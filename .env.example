# Azure Speech Service Credentials
# Get these from your Azure portal (Speech Service resource)

# Your Azure Speech Service subscription key
AZURE_SPEECH_KEY="YOUR_AZURE_SPEECH_SUBSCRIPTION_KEY"

# The region where your Azure Speech Service resource is located (e.g., westus, eastus)
AZURE_SPEECH_REGION="YOUR_AZURE_SPEECH_SERVICE_REGION"

# Azure OpenAI Credentials (Optional, needed for highlight_creator.py)
# Get these from your Azure portal (Azure OpenAI resource)
AZURE_OPENAI_KEY="YOUR_AZURE_OPENAI_API_KEY"
AZURE_OPENAI_ENDPOINT="YOUR_AZURE_OPENAI_ENDPOINT" # e.g., https://your-resource-name.openai.azure.com/
# The deployment name of your GPT model (e.g., gpt-4o-mini)
AZURE_OPENAI_DEPLOYMENT_NAME="YOUR_GPT_DEPLOYMENT_NAME" 